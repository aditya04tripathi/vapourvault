# VapourVault — local development (copy to .env)

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

POSTGRES_USER=user
POSTGRES_PASSWORD=devpass
POSTGRES_DB=vapourvault
DATABASE_URL=postgresql://user:devpass@127.0.0.1:5432/vapourvault

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=24h

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=devpass

REDIS_URL=redis://127.0.0.1:6379

LOG_LEVEL=debug
ENABLE_TRACING=false

CORS_ORIGIN=http://localhost:3000

RUN_MIGRATIONS=false
