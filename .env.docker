# VaporVault Environment Variables (Docker)

# Application
NODE_ENV=development
PORT=49155

# Database Configuration (dev-db is the docker service name)
DATABASE_URL=postgresql://user:password@dev-db:5432/template_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# MinIO Storage Configuration (minio is the docker service name)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Redis Configuration (redis is the docker service name)
REDIS_URL=redis://redis:6379

# Observability & Monitoring
LOG_LEVEL=info
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# CORS
CORS_ORIGIN=http://localhost:3000
