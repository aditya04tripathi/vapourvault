# VapourVault — production / Railway

NODE_ENV=production
# PORT is injected by Railway at runtime

DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=24h

MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

REDIS_URL=

LOG_LEVEL=info
ENABLE_TRACING=true
OTEL_SERVICE_NAME=vapourvault-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.adityatripathi.dev

CORS_ORIGIN=https://your-app.up.railway.app

RUN_MIGRATIONS=true
